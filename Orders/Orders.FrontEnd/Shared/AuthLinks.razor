<AuthorizeView>
    <Authorized>
        <span class="d-flex align-items-center">
            Hola, <a herf="EditUser" class="nav-link btn btn-link">@context.User.Identity!.Name</a>
        </span>
        @if (!string.IsNullOrEmpty(photoUser))
        {
            <div class="mx-2">
                <img src="@photoUser" class="imageUser" width="50" height="50" />
            </div>
        }
        <a href="Logout" class="nav-link btn btn-link">Cerrar Sesión</a>
    </Authorized>
    <NotAuthorized>
        <a href="Register" class="nav-link btn btn-link">Registro</a>
        <a @onclick=@(() => ShowModal()) class="nav-link btn btn-link">Iniciar Sesión</a>
    </NotAuthorized>
</AuthorizeView>
