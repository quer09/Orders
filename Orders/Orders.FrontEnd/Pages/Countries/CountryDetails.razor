@page "/countries/details/{CountryId:int}"

@if (country is null)
{
    <Loading/>
}
else
{
    <h3>@country.Name</h3>
    <div class="mb-2">
        <a class="btn btn-primary" href="/states/create/@country.Id"> Nuevo Departamento/Estado</a>
        <a class="btn btn-success" href="/countries">Regresar</a>
    </div>

    <h4>Departamentos/Estados</h4>
    <GenericList MyList="states!">
        <Body>
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPageAsync" />

            <div class="filter-div">
                <input class="form-control" type="text" id="titulo" placeholder="Buscar departamento/estado..." @bind-value="Filter" />
                <button type="button" class="btn btn-outline-primary mx-1" @onclick="ApplyFilterAsync">Filtrar</button>
                <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsycn">Limpiar</button>
            </div>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Departamento / Estado</th>
                        <th  class="th-table2">Cuidades</th>
                        <th  class="th-table1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var state in states!)
                    {
                        <tr>
                            <td>@state.Name</td>
                            <td>@state.CitiesNumber</td>
                            <td>
                                <a class="btn btn-sm btn-warning" href="/states/edit/@state.Id">Editar</a>
                                <a class="btn btn-sm btn-info" href="/states/details/@state.Id">Detalles</a>
                                <button class="btn btn-sm btn-danger" @onclick="(() => DeleteAsync(state))">Borrar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
}