@page "/countries/details/{CountryId:int}"

@if (country is null)
{
    <Loading />
}
else
{
    <div class="card">
        <div class="card-header">
            <span>
                <i class="bi bi-globe-americas" /> @country.Name
                <a class="btn btn-primary float-end mx-1" href="/states/create/@country.Id"><i class="bi bi-plus-square" /> Adicionar Departamento/Estado</a>
                <a class="btn btn-success float-end" href="/countries"><i class="bi bi-arrow-left" /> Regresar</a>
            </span>
        </div>
        <div class="card-body">
            <GenericList MyList="states!">
                <Body>
                    <div class="filter-div">
                        <input class="form-control" type="text" id="titulo" placeholder="Buscar departamento/estado..." @bind-value="Filter" />
                        <button type="button" class="btn btn-outline-primary mx-1" @onclick="ApplyFilterAsync"><i class="bi bi-funnel" /> Filtrar</button>
                        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsycn"><i class="bi bi-x-circle" /> Limpiar</button>
                    </div>

                    <Pagination CurrentPage="currentPage"
                                TotalPages="totalPages"
                                SelectedPage="SelectedPageAsync" />

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Departamento / Estado</th>
                                <th class="th-table3">Cuidades</th>
                                <th class="th-table2"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var state in states!)
                            {
                                <tr>
                                    <td><a href="/states/details/@state.Id">@state.Name</a></td>
                                    <td>@state.CitiesNumber</td>
                                    <td>
                                        <a class="btn btn-sm btn-warning" href="/states/edit/@state.Id"><i class="bi bi-pencil" /> Editar</a>
                                        <button class="btn btn-sm btn-danger" @onclick="(() => DeleteAsync(state))"><i class="bi bi-trash" /> Borrar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </GenericList>
        </div>
    </div>
}