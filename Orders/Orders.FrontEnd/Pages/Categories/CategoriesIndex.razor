@page "/categories"

<div class="card">
    <div class="card-header">
        <span>
            <i class="bi bi-globe-americas" /> Categorias
            <a class="btn btn-primary float-end mx-1" href="/categories/create"><i class="bi bi-plus-square" /> Adicionar Categoría</a>
        </span>
    </div>
    <div class="card-body">
        <GenericList MyList="Categories">
            <Body>
                <div class="filter-div">
                    <input class="form-control" type="text" id="titulo" placeholder="Buscar categoria..." @bind-value="Filter" />
                    <button type="button" class="btn btn-outline-primary mx-1" @onclick="ApplyFilterAsync"><i class="bi bi-funnel" /> Filtrar</button>
                    <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsycn"><i class="bi bi-x-circle" /> Limpiar</button>
                </div>

                <Pagination CurrentPage="currentPage"
                            TotalPages="totalPages"
                            SelectedPage="SelectedPageAsync" />

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Categoría</th>
                            <th class="th-table2"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Categories!)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>
                                    <a href="/categories/edit/@category.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil" /> Editar</a>
                                    <button @onclick=@(() => DeleteAsync(category)) class="btn btn-sm btn-danger"><i class="bi bi-trash" /> Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </GenericList>
    </div>
</div>